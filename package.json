{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "Repo-agnostic agent harness driven by the Claude Agent SDK and the Codex SDK.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "harness": "node --experimental-strip-types apps/orchestrator/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
